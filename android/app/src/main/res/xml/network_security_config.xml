<?xml version="1.0" encoding="utf-8"?>
<!--
  CrimeGraph has no cloud or arbitrary web-service dependency. Deny cleartext
  globally and do not opt in to user-installed CAs in release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
