{
  "name": "crimegraph",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build": "npm run typecheck && vite build",
    "generate-assets": "capacitor-assets generate",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "build:android": "npm run build && npm run sync:android && cd android && ./gradlew assembleDebug --no-daemon"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor-community/electron": "^5.0.0",
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "cordova-plugin-bluetoothle": "^6.7.4",
    "cytoscape": "^3.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.2",
    "vis-timeline": "^7.7.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "sql.js": "1.11.0"
  }
}
